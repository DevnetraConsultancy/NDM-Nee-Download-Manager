{
  "manifest_version": 2,
  "name": "Nee Download Manager",
  "short_name": "NDM",
  "version": "1.0.5",
  "description": "Send downloads, links and videos to Nee Download Manager. MIT License, (c) 2026 Devnetra Consultancy.",
  "author": "Devnetra Consultancy",

  "icons": {
    "16":  "images/ndm16.png",
    "32":  "images/ndm32.png",
    "48":  "images/ndm48.png",
    "128": "images/ndm128.png"
  },

  "browser_action": {
    "default_icon": {
      "16":  "images/ndm16.png",
      "32":  "images/ndm32.png",
      "48":  "images/ndm48.png"
    },
    "default_title": "Nee Download Manager",
    "default_popup": "popup.html",
    "browser_style": false
  },

  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],

  "permissions": [
    "downloads",
    "menus",
    "cookies",
    "storage",
    "notifications",
    "nativeMessaging",
    "webRequest",
    "<all_urls>"
  ],

  "options_ui": {
    "page": "captured.html",
    "open_in_tab": true
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "ndm@devnetra.com",
      "strict_min_version": "109.0"
    }
  },

  "content_security_policy": "script-src 'self'; object-src 'self'"
}
