// NDMan.rc -- NDM application resources
// Invented with Care By Devnetra Consultancy
#include <winres.h>
#include "../src/ui/ndm_resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_NDM ICON "icons/ndm.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,5,0
 PRODUCTVERSION  1,0,5,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Devnetra Consultancy"
            VALUE "FileDescription",  "NDM - Nee Download Manager"
            VALUE "FileVersion",      "1.0.5.0"
            VALUE "InternalName",     "NDMan"
            VALUE "LegalCopyright",   "\xA9 2026 Devnetra Consultancy - MIT License"
            VALUE "OriginalFilename", "NDMan.exe"
            VALUE "ProductName",      "Nee Download Manager"
            VALUE "ProductVersion",   "1.0.5"
            VALUE "Comments",         "Invented with Care By Devnetra Consultancy"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
